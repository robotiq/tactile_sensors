@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The dependencies mirror how this package was built: the SDK carries no
# third-party library of its own, and a freestanding build needs no Threads
# either.
if(@GRIPPERS_HOSTED@)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/grippers-targets.cmake")
check_required_components(grippers)
